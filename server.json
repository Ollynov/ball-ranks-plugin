{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Ollynov/ball-ranks",
  "title": "Ball Ranks Fantasy Sports",
  "description": "Fantasy football and basketball rankings and player projections from Ball Ranks.",
