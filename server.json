  "repository": {
    "url": "https://github.com/Ollynov/ball-ranks-plugin",
    "source": "github"
  },
  "version": "1.1.2",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Ollynov/ball-ranks-plugin/main/assets/icon.png",
      "mimeType": "image/png",
      "sizes": ["128x128"],
      "theme": "light"
    },
    {
      "src": "https://raw.githubusercontent.com/Ollynov/ball-ranks-plugin/main/assets/icon-dark.png",
